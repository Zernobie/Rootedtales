<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1a472a"
                android:centerColor="#22543d"
                android:endColor="#166534"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Forest pattern overlay (optional) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#10000000" />
        </shape>
    </item>
</layer-list>
